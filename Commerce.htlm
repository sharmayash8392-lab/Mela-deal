<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apna Store</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #f7f7f9; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="max-w-md mx-auto min-h-screen bg-gray-50 flex flex-col justify-between shadow-lg">

  <!-- TOP APP BAR -->
  <header class="bg-indigo-600 text-white p-3 sticky top-0 z-50">
    <div class="flex items-center justify-between mb-2">
      <h1 class="font-bold text-lg tracking-wide">Apna Store</h1>
      <div class="flex items-center gap-4 text-lg">
        <i class="fa-regular fa-heart"></i>
        <div class="relative cursor-pointer" onclick="openCart()">
          <i class="fa-solid fa-cart-shopping"></i>
          <span id="cart-badge" class="absolute -top-2 -right-2 bg-amber-400 text-black text-xs font-bold rounded-full w-4 h-4 flex items-center justify-center">1</span>
        </div>
      </div>
    </div>
    <!-- Search Bar -->
    <div class="relative">
      <input type="text" placeholder="Search products..." class="w-full py-2 pl-9 pr-4 rounded-lg text-sm text-gray-800 bg-white outline-none">
      <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-gray-400 text-sm"></i>
    </div>
  </header>

  <!-- MAIN SCROLLABLE CONTENT -->
  <main class="flex-1 pb-20 overflow-y-auto">
    <!-- Category Pills -->
    <div class="flex gap-3 p-3 overflow-x-auto no-scrollbar bg-white border-b">
      <div class="flex flex-col items-center flex-shrink-0 w-16">
        <div class="w-12 h-12 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 text-xl font-bold">All</div>
        <span class="text-xs mt-1 text-gray-600">All</span>
      </div>
      <div class="flex flex-col items-center flex-shrink-0 w-16">
        <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 text-xl"><i class="fa-solid fa-shirt"></i></div>
        <span class="text-xs mt-1 text-gray-600">Men</span>
      </div>
      <div class="flex flex-col items-center flex-shrink-0 w-16">
        <div class="w-12 h-12 rounded-full bg-pink-100 flex items-center justify-center text-pink-600 text-xl"><i class="fa-solid fa-person-dress"></i></div>
        <span class="text-xs mt-1 text-gray-600">Women</span>
      </div>
      <div class="flex flex-col items-center flex-shrink-0 w-16">
        <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 text-xl"><i class="fa-solid fa-glasses"></i></div>
        <span class="text-xs mt-1 text-gray-600">Fashion</span>
      </div>
    </div>

    <!-- Sale Banner -->
    <div class="m-3 p-3 bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl text-white flex justify-between items-center shadow-sm">
      <div>
        <p class="text-xs uppercase tracking-wider font-semibold">Special Offer</p>
        <h2 class="text-lg font-bold">Flat 50% Off Today</h2>
      </div>
      <div class="text-xs bg-white text-indigo-700 px-2.5 py-1.5 rounded-lg font-bold">
        Ends in: 04h 22m
      </div>
    </div>

    <!-- Product Grid -->
    <div class="px-3">
      <h3 class="font-bold text-gray-800 mb-2">Featured Products</h3>
      <div class="grid grid-cols-2 gap-3">
        
        <!-- Product Card 1 -->
        <div class="bg-white rounded-lg p-2.5 shadow-sm border border-gray-100 flex flex-col justify-between">
          <div>
            <div class="h-32 bg-gray-200 rounded-md flex items-center justify-center text-gray-400">
              <i class="fa-solid fa-shirt text-3xl"></i>
            </div>
            <h4 class="font-medium text-sm mt-2 text-gray-800 line-clamp-1">Casual Cotton Shirt</h4>
            <div class="flex items-center gap-2 mt-1">
              <span class="font-bold text-base text-gray-900">₹199</span>
              <span class="text-xs text-gray-400 line-through">₹499</span>
              <span class="text-xs font-semibold text-emerald-600">60% off</span>
            </div>
          </div>
          <button onclick="openCheckout('Casual Cotton Shirt', 199)" class="w-full mt-3 bg-indigo-600 text-white py-1.5 rounded-md text-xs font-semibold hover:bg-indigo-700">
            Buy Now
          </button>
        </div>

        <!-- Product Card 2 -->
        <div class="bg-white rounded-lg p-2.5 shadow-sm border border-gray-100 flex flex-col justify-between">
          <div>
            <div class="h-32 bg-gray-200 rounded-md flex items-center justify-center text-gray-400">
              <i class="fa-solid fa-glasses text-3xl"></i>
            </div>
            <h4 class="font-medium text-sm mt-2 text-gray-800 line-clamp-1">Retro Sunglasses</h4>
            <div class="flex items-center gap-2 mt-1">
              <span class="font-bold text-base text-gray-900">₹149</span>
              <span class="text-xs text-gray-400 line-through">₹299</span>
              <span class="text-xs font-semibold text-emerald-600">50% off</span>
            </div>
          </div>
          <button onclick="openCheckout('Retro Sunglasses', 149)" class="w-full mt-3 bg-indigo-600 text-white py-1.5 rounded-md text-xs font-semibold hover:bg-indigo-700">
            Buy Now
          </button>
        </div>

      </div>
    </div>
  </main>

  <!-- CHECKOUT MODAL (Single Pay Now Option with your UPI ID) -->
  <div id="checkout-modal" class="fixed inset-0 bg-black/60 z-50 hidden flex items-end justify-center">
    <div class="bg-white w-full max-w-md rounded-t-2xl p-4 transition-all">
      <div class="flex justify-between items-center pb-3 border-b">
        <h3 class="font-bold text-gray-800">Checkout & Payment</h3>
        <button onclick="closeCheckout()" class="text-gray-400 text-lg">&times;</button>
      </div>

      <!-- Item Detail -->
      <div class="py-3 flex justify-between items-center text-sm border-b">
        <span id="checkout-item-name" class="text-gray-700 font-medium">Product</span>
        <span id="checkout-item-price" class="font-bold text-gray-900">₹0</span>
      </div>

      <!-- Address Input -->
      <div class="my-3">
        <label class="text-xs font-medium text-gray-600">Delivery Address</label>
        <textarea rows="2" placeholder="House no, Street, City, Pincode" class="w-full mt-1 p-2 border rounded-lg text-xs outline-none focus:border-indigo-600"></textarea>
      </div>

      <!-- Single UPI Payment Box -->
      <div class="bg-indigo-50 border border-indigo-200 rounded-xl p-3 mb-4">
        <div class="flex items-center gap-2 mb-1">
          <i class="fa-solid fa-circle-check text-indigo-600 text-sm"></i>
          <span class="text-xs font-bold text-gray-800 uppercase tracking-wide">Pay Online via UPI</span>
        </div>
        <p class="text-xs text-gray-600">Payment ID:</p>
        <div class="flex justify-between items-center mt-1 bg-white p-2 rounded border border-gray-200">
          <span class="font-mono text-xs font-bold text-indigo-700 select-all">8392966659@ptsbi</span>
          <span class="text-[10px] text-gray-400 font-medium">Verified Merchant/VPA</span>
        </div>
      </div>

      <!-- Final Pay Now Action Button -->
      <button onclick="triggerUPIPayment()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
        <span>Pay Now</span>
        <span id="btn-amount" class="bg-indigo-800 text-xs px-2 py-0.5 rounded">₹0</span>
      </button>
    </div>
  </div>

  <!-- BOTTOM NAVIGATION -->
  <nav class="bg-white border-t border-gray-200 fixed bottom-0 max-w-md w-full flex justify-around py-2.5 text-xs text-gray-500">
    <div class="flex flex-col items-center text-indigo-600 font-semibold cursor-pointer">
      <i class="fa-solid fa-house text-base"></i>
      <span>Home</span>
    </div>
    <div class="flex flex-col items-center cursor-pointer">
      <i class="fa-solid fa-table-cells-large text-base"></i>
      <span>Categories</span>
    </div>
    <div class="flex flex-col items-center cursor-pointer">
      <i class="fa-solid fa-box text-base"></i>
      <span>Orders</span>
    </div>
    <div class="flex flex-col items-center cursor-pointer">
      <i class="fa-solid fa-user text-base"></i>
      <span>Profile</span>
    </div>
  </nav>

  <script>
    let currentPrice = 0;
    const upiId = "8392966659@ptsbi";

    function openCheckout(name, price) {
      currentPrice = price;
      document.getElementById('checkout-item-name').innerText = name;
      document.getElementById('checkout-item-price').innerText = "₹" + price;
      document.getElementById('btn-amount').innerText = "₹" + price;
      document.getElementById('checkout-modal').classList.remove('hidden');
    }

    function closeCheckout() {
      document.getElementById('checkout-modal').classList.add('hidden');
    }

    function triggerUPIPayment() {
      // Mobile me GPay/PhonePe/Paytm direct open karne ka UPI intent URL
      const upiUrl = `upi://pay?pa=${upiId}&pn=StoreOrder&am=${currentPrice}&cu=INR`;
      window.location.href = upiUrl;
    }
  </script>
</body>
</html>
